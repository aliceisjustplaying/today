# Copy to .env for local dev; Bun loads it automatically.
# In production the same names come from the systemd unit (secrets via LoadCredential).

# Required
ALLOWED_EMAIL=you@example.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SESSION_SECRET=

# Optional: public callback URL. Set it when the server sits behind a TLS proxy;
# when empty the callback is derived from the request URL.
GOOGLE_OAUTH_REDIRECT_URI=

# Optional: travel estimates (both needed)
GOOGLE_API_KEY=
HOME_ADDRESS=

# Optional: behaviour (defaults shown)
TIMEZONE=Europe/London
TRANSPORT_DEFAULT=TRANSIT
TRANSPORT_RESCUE=DRIVE
BUFFER_MINUTES=10

# Optional: server (defaults shown)
HOST=127.0.0.1
PORT=8788
DATABASE_PATH=data/today.sqlite
MIGRATIONS_DIR=drizzle/migrations
STATIC_DIR=dist/client

# Optional: extra Vite dev hosts, comma-separated
VITE_ALLOWED_HOSTS=

# Not read yet; reserved for future AI features
# ANTHROPIC_API_KEY=
# YNAB_PAT=
